SDI_ENVIRONMENT=development
SDI_SERVICE_VERSION=0.2.0
# Use an async SQLAlchemy URL in deployed environments.
# SDI_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sdi
SDI_DB_POOL_SIZE=5
SDI_DB_MAX_OVERFLOW=10
SDI_JWT_SECRET=replace-with-a-secret-from-your-secret-manager
SDI_JWT_ISSUER=sdi-api
SDI_ACCESS_TOKEN_TTL_MINUTES=15
